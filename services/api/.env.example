# Copy to .env (never commit it) or set these in the environment. Server-side only.

# Required. PostgreSQL connection string (psycopg3 driver).
DATABASE_URL=postgresql+psycopg://inkloom:inkloom@localhost:5432/inkloom

# Required. Random secret used to sign session/auth tokens (Phase 2). Generate with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`. At least 32 characters: with a
# shorter or missing key no token is signed or accepted, and ENVIRONMENT=production refuses to start.
AUTH_SECRET_KEY=

# Optional (defaults shown).
# ENVIRONMENT=development            # development | test | production
# LOG_LEVEL=INFO
# CORS_ALLOW_ORIGINS=http://localhost:3000
# AUTH_TOKEN_TTL_MINUTES=720          # 12 hours; how long a login token is valid

# Trust Scorecard (POST /api/evaluations): one synchronous run of the engine's 80-claim labelled
# evaluation, bounded by the engine's call budget. A run where more than
# EVAL_MAX_PROVIDER_FAILURE_RATE of the claims got no verdict is not stored.
# EVAL_MAX_CALLS=150
# EVAL_DEADLINE_SECONDS=300
# EVAL_MIN_INTERVAL_SECONDS=600       # once per 10 minutes per user
# EVAL_MAX_PROVIDER_FAILURE_RATE=0.2

# Self-serve onboarding (POST /api/auth/register): rate-limited per client IP (never
# X-Forwarded-For - an untrusted caller can set that to anything).
# RATE_LIMIT_REGISTRATIONS_PER_IP=5
# RATE_LIMIT_REGISTRATION_WINDOW_SECONDS=600  # 10 minutes

# Security limits (services/verification/SECURITY.md, "Whole system"; defaults shown).
# Review submissions per user / organisation per window; over the limit: 429 with retry_after.
# These counters are in memory, per process: with several workers each has its own.
# RATE_LIMIT_SUBMISSIONS_PER_USER=20
# RATE_LIMIT_SUBMISSIONS_PER_ORGANISATION=100
# RATE_LIMIT_WINDOW_SECONDS=60
# MAX_REQUEST_BODY_BYTES=1000000      # JSON bodies; uploads get MAX_SOURCE_UPLOAD_BYTES + 1 MB
# DB_STATEMENT_TIMEOUT_MS=15000       # PostgreSQL statement_timeout on every connection
# Per review: claims kept, model calls (retries count), estimated tokens, wall-clock seconds.
# A review that reaches a limit is marked for human review; nothing past it reaches a model.
# REVIEW_MAX_CLAIMS=50
# REVIEW_MAX_LLM_CALLS=100
# REVIEW_MAX_ESTIMATED_TOKENS=400000
# REVIEW_DEADLINE_SECONDS=180

# Where GET /api/evaluations/latest reads engine evaluation reports from.
# EVALUATION_REPORTS_DIR=../verification/eval/reports

# --- AI engine provider fallback chain (Phase 5) ------------------------------------------------
# Without at least one of these configured, POST /api/reviews still works but writes one
# clearly-labelled stub finding instead of a real one (src/inkloom_api/engine/pipeline.py). Each
# is tried in this fixed order on every call - Gemini, then Groq, then OpenRouter :free models,
# then local Ollama - falling through to the next on ANY provider failure (not just rate limits:
# see src/inkloom_api/engine/providers/fallback.py). Only once every configured provider has
# failed does the review become `failed`. All read directly from the process environment by
# this app's provider adapter (this app loads this .env file into the real environment at
# startup via python-dotenv, see main.py) - none of these are fields of this app's own Settings
# class. None are required; configure as many or as few as you like.

# 1) Google AI Studio (Gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Required alongside the key above. Pick a current id from
# https://ai.google.dev/gemini-api/docs/models - never hard-coded in code, free-tier ids change.
# Verified 2026-10-24 against that live list AND real calls: gemini-3.5-flash-lite (stable) is
# the recommended default - ~1s per call, so the Trust Scorecard's 80-claim evaluation finishes
# inside its time budget (POST /api/evaluations), and reviews + suggested corrections were correct
# in a real run. gemini-3.6-flash (stable) also works but ~5s per call with frequent free-tier
# 503s; an evaluation run with it ran out of time. gemini-3.8-flash is listed stable but timed out
# (504) on every call from a free-tier key that day; gemini-2.5-* return 404 "no longer available
# to new users". Re-check the list if a call starts failing.
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini is used only when this is "true". Set it only for a key on a PAID tier: under the
# Gemini API terms, free-tier ("Unpaid Services") prompts and responses are used to improve
# Google's products and may be read by human reviewers, so customer content is not sent there.
# GEMINI_PAID_TIER=false

# 2) Groq — https://console.groq.com/keys
GROQ_API_KEY=
# Required alongside the key above. The team's stated preference (phase5 task 1): Llama 3.3
# 70B, Llama 4, or gpt-oss. Pick a current id from https://console.groq.com/docs/models.
GROQ_MODEL=

# 3) OpenRouter `:free` models — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-new-key
# Required alongside the key above. Comma-separated OpenRouter model ids, tried in order by
# OpenRouterProvider's own internal retry (a different thing from this file's provider-to-
# provider fallback). Pick ids from https://openrouter.ai/models that support structured
# outputs. Check the exact ids there; they change over time. The live list (with each model's
# supported_parameters) is at https://openrouter.ai/api/v1/models - a model WITHOUT
# "response_format" there answers 404 under this engine's require_parameters setting (that is
# what broke nvidia/nemotron-3.5-lightning:free, previously configured here).
# Verified 2026-10-24 with a real call: nvidia/nemotron-3.5-super-vl:free works;
# google/gemma-4-31b-it:free supports structured output but was rate-limited (429) that day.
INKLOOM_LLM_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free

# Optional (defaults shown) - see services/verification/.env.example for the full description.
# INKLOOM_LLM_TIMEOUT_SECONDS=30
# INKLOOM_LLM_MAX_RETRIES=2
# INKLOOM_LLM_SEED=0
# INKLOOM_LLM_STRUCTURED_OUTPUT=json_schema
INKLOOM_LLM_DATA_COLLECTION=deny
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 4) Local Ollama — https://github.com/ollama/ollama. The only provider usable for confidential
# brand sources (Phase 5 task 8: no content leaves the machine). No API key.
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=