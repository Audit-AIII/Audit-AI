# Copy to .env (never commit it) or set these in the environment. Server-side only.

# Required. PostgreSQL connection string (psycopg3 driver).
DATABASE_URL=postgresql+psycopg://inkloom:inkloom@localhost:5432/inkloom

# Required. Random secret used to sign session/auth tokens (Phase 2). Generate with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
AUTH_SECRET_KEY=

# Optional (defaults shown).
# ENVIRONMENT=development            # development | test | production
# LOG_LEVEL=INFO
# CORS_ALLOW_ORIGINS=http://localhost:3000
# AUTH_TOKEN_TTL_MINUTES=720          # 12 hours; how long a login token is valid

# --- AI engine (Member 2, services/verification) -----------------------------------------------
# Without these, POST /api/reviews still works but writes one clearly-labelled stub finding
# instead of a real one (see src/inkloom_api/engine/pipeline.py). Read directly by
# inkloom_verify.providers.openrouter from the process environment — this app loads this .env
# file into the real environment at startup (python-dotenv, see main.py) specifically so these
# reach it; they are not fields of this app's own Settings class.

# Required for real AI checks. OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required for real AI checks. Comma-separated OpenRouter model ids, tried in order. Pick ids
# from https://openrouter.ai/models that support structured outputs, e.g. a Gemini Flash model
# first and a Llama model as fallback. Check the exact ids there; they change over time.
INKLOOM_LLM_MODELS=

# Optional (defaults shown) - see services/verification/.env.example for the full description.
# INKLOOM_LLM_TIMEOUT_SECONDS=30
# INKLOOM_LLM_MAX_RETRIES=2
# INKLOOM_LLM_SEED=0
# INKLOOM_LLM_STRUCTURED_OUTPUT=json_schema
# INKLOOM_LLM_DATA_COLLECTION=deny
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
