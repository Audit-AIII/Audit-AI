{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "description": "One atomic, checkable statement extracted from the content.\n\n``text`` is exactly the content at ``source_span`` (``content[start:end] == text``; the\nlengths are checked here, the characters by ``scope.check_report_scope``, which has the\ncontent). ``normalized_text`` is the claim reworded to stand alone, when the extractor\nreworded it; it never adds facts (extraction.rewrite_problems). ``statement`` is what\nretrieval, the verifier and the corrector work on.",
      "properties": {
        "claim_id": {
          "pattern": "^clm_[A-Za-z0-9_-]{1,64}$",
          "title": "Claim Id",
          "type": "string"
        },
        "normalized_text": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Text"
        },
        "source_span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "source_span"
      ],
      "title": "Claim",
      "type": "object"
    },
    "EvidencePassage": {
      "additionalProperties": false,
      "description": "A verbatim excerpt of one reference document, located by offsets into that document.",
      "properties": {
        "doc_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Doc Id",
          "type": "string"
        },
        "doc_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Doc Text Sha256",
          "type": "string"
        },
        "passage_id": {
          "pattern": "^psg_[A-Za-z0-9_-]{1,64}$",
          "title": "Passage Id",
          "type": "string"
        },
        "reference_set_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Set Id"
        },
        "retrieval": {
          "$ref": "#/$defs/RetrievalProvenance"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "passage_id",
        "doc_id",
        "doc_text_sha256",
        "span",
        "text",
        "retrieval"
      ],
      "title": "EvidencePassage",
      "type": "object"
    },
    "RetrievalMethod": {
      "enum": [
        "bm25"
      ],
      "title": "RetrievalMethod",
      "type": "string"
    },
    "RetrievalProvenance": {
      "additionalProperties": false,
      "description": "How a passage was found. Scores are only comparable within one retrieval call.",
      "properties": {
        "method": {
          "$ref": "#/$defs/RetrievalMethod"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "method",
        "score",
        "rank"
      ],
      "title": "RetrievalProvenance",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "A half-open ``[start, end)`` range of code points in one specific text.",
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Everything the verifier is allowed to see: one claim and the passages retrieved for it.\n\nThe reference corpus is deliberately absent. A claim with no retrieved passages never\nreaches the verifier; the engine records NOT_ENOUGH_EVIDENCE for it directly.",
  "properties": {
    "claim": {
      "$ref": "#/$defs/Claim"
    },
    "passages": {
      "items": {
        "$ref": "#/$defs/EvidencePassage"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Passages",
      "type": "array"
    }
  },
  "required": [
    "claim",
    "passages"
  ],
  "title": "ClaimVerificationInput",
  "type": "object"
}
