{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "description": "An exact quote from one evidence passage, located in the original reference document.\n\n``quote_span`` is in reference-document coordinates (the same as ``EvidencePassage.span``),\nso a citation can be checked against the original text without the passage.",
      "properties": {
        "doc_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Doc Id",
          "type": "string"
        },
        "doc_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Doc Text Sha256",
          "type": "string"
        },
        "passage_id": {
          "pattern": "^psg_[A-Za-z0-9_-]{1,64}$",
          "title": "Passage Id",
          "type": "string"
        },
        "quote": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "quote_span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "doc_id",
        "doc_text_sha256",
        "passage_id",
        "quote",
        "quote_span"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CitationGuardReport": {
      "additionalProperties": false,
      "description": "What the model answered and what the citation guard did with it.\n\nPolicy: a SUPPORTED or CONTRADICTED answer stands only if it has at least one citation and\nevery citation passes the guard. Otherwise it is downgraded to NOT_ENOUGH_EVIDENCE.",
      "properties": {
        "downgraded": {
          "title": "Downgraded",
          "type": "boolean"
        },
        "model_verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "rejected": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RejectedCitation"
          },
          "title": "Rejected",
          "type": "array"
        }
      },
      "required": [
        "model_verdict",
        "downgraded"
      ],
      "title": "CitationGuardReport",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "One atomic, checkable statement extracted from the content.\n\n``text`` is exactly the content at ``source_span`` (``content[start:end] == text``; the\nlengths are checked here, the characters by ``scope.check_report_scope``, which has the\ncontent). ``normalized_text`` is the claim reworded to stand alone, when the extractor\nreworded it; it never adds facts (extraction.rewrite_problems). ``statement`` is what\nretrieval, the verifier and the corrector work on.",
      "properties": {
        "claim_id": {
          "pattern": "^clm_[A-Za-z0-9_-]{1,64}$",
          "title": "Claim Id",
          "type": "string"
        },
        "normalized_text": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Text"
        },
        "source_span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "source_span"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimResult": {
      "additionalProperties": false,
      "description": "The outcome for one claim.\n\nVerdict rules:\n\n* SUPPORTED / CONTRADICTED: at least one citation; no error.\n* NOT_ENOUGH_EVIDENCE: no citations, no correction, no error. ``evidence`` may still list\n  the passages that were considered.\n* ERROR: an error; no citations, no correction.\n* A correction is only allowed on CONTRADICTED, must stay inside the claim's source span,\n  and may only cite quotes that are also citations of this result.\n* Every citation must quote, verbatim, a passage listed in ``evidence``.\n* ``citation_guard``, when present, must agree with the verdict: a downgraded answer is\n  NOT_ENOUGH_EVIDENCE, and an accepted answer has the verdict the model gave.",
      "properties": {
        "citation_guard": {
          "anyOf": [
            {
              "$ref": "#/$defs/CitationGuardReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "citations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 8,
          "title": "Citations",
          "type": "array"
        },
        "claim": {
          "$ref": "#/$defs/Claim"
        },
        "conflicting_sources": {
          "title": "Conflicting Sources",
          "type": "boolean"
        },
        "correction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Correction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "correction_attempt": {
          "anyOf": [
            {
              "$ref": "#/$defs/CorrectionAttempt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessingError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidencePassage"
          },
          "maxItems": 8,
          "title": "Evidence",
          "type": "array"
        },
        "evidence_strength": {
          "$ref": "#/$defs/EvidenceStrength"
        },
        "model_rationale": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Rationale"
        },
        "requires_human_review": {
          "title": "Requires Human Review",
          "type": "boolean"
        },
        "review_reasons": {
          "items": {
            "$ref": "#/$defs/ClaimReviewReason"
          },
          "title": "Review Reasons",
          "type": "array"
        },
        "safer_wording": {
          "anyOf": [
            {
              "$ref": "#/$defs/SaferWording"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "claim",
        "verdict"
      ],
      "title": "ClaimResult",
      "type": "object"
    },
    "ClaimReviewReason": {
      "description": "Why one claim goes to a person (EVAL.md Phase 5, decision-policy-v1).\n\nThe first four are the fixed floor (``floor_review_reasons``): no configuration can remove\nthem. The last two are added by a configurable ``DecisionPolicy`` (``decision_policy.py``),\nonly to SUPPORTED claims: a policy can route more claims to review, never fewer.",
      "enum": [
        "contradicted",
        "not_enough_evidence",
        "error",
        "weak_evidence",
        "below_policy_strength",
        "compound_under_cited"
      ],
      "title": "ClaimReviewReason",
      "type": "string"
    },
    "Correction": {
      "additionalProperties": false,
      "description": "A proposed replacement for part of the content, justified only by its citations.\n\nContract-level guard: any number the replacement introduces must appear in a cited quote.\nFull fact checking of the replacement (names, units, re-verification) is the correction\nstage's job; this rule only makes the most common fabrication unrepresentable.",
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "original_text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Original Text",
          "type": "string"
        },
        "replacement_text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Replacement Text",
          "type": "string"
        },
        "target_span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "target_span",
        "original_text",
        "replacement_text",
        "citations"
      ],
      "title": "Correction",
      "type": "object"
    },
    "CorrectionAttempt": {
      "additionalProperties": false,
      "description": "What happened when a correction was attempted for a CONTRADICTED claim.\n\nPROPOSED: a correction is attached to the result and passed every check (and the re-check,\nwhen one ran). NEEDS_HUMAN_REVIEW: no correction is attached; ``issues`` says why.\nFAILED: no correction is attached; ``error`` says why.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessingError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CorrectionIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "recheck_verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/Verdict"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/CorrectionStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "CorrectionAttempt",
      "type": "object"
    },
    "CorrectionIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/CorrectionIssueCode"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "code"
      ],
      "title": "CorrectionIssue",
      "type": "object"
    },
    "CorrectionIssueCode": {
      "enum": [
        "model_declined",
        "no_citation",
        "unknown_citation",
        "target_not_found",
        "no_change",
        "unsupported_addition",
        "not_minimal",
        "drops_qualifier",
        "drops_unit",
        "drops_attribution",
        "recheck_not_supported",
        "recheck_unavailable",
        "invalid_correction"
      ],
      "title": "CorrectionIssueCode",
      "type": "string"
    },
    "CorrectionStatus": {
      "enum": [
        "proposed",
        "needs_human_review",
        "failed"
      ],
      "title": "CorrectionStatus",
      "type": "string"
    },
    "EngineProvenance": {
      "additionalProperties": false,
      "description": "What produced a report, so results can be reproduced and compared across versions.",
      "properties": {
        "contract_version": {
          "const": "0.2.0",
          "default": "0.2.0",
          "title": "Contract Version",
          "type": "string"
        },
        "engine_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Engine Version",
          "type": "string"
        },
        "model_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "prompt_versions": {
          "additionalProperties": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "default": {},
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1
          },
          "title": "Prompt Versions",
          "type": "object"
        },
        "provider": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "retrieval_method": {
          "$ref": "#/$defs/RetrievalMethod"
        }
      },
      "required": [
        "engine_version",
        "retrieval_method"
      ],
      "title": "EngineProvenance",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "INVALID_REQUEST",
        "LIMIT_EXCEEDED",
        "PROVIDER_NOT_CONFIGURED",
        "PROVIDER_TIMEOUT",
        "PROVIDER_RATE_LIMITED",
        "PROVIDER_QUOTA_EXCEEDED",
        "PROVIDER_ERROR",
        "MALFORMED_MODEL_OUTPUT",
        "INTERNAL_ERROR"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "EvidenceCoverage": {
      "additionalProperties": false,
      "description": "Share of checked claims backed by validated evidence: supported / checked.\n\n``checked`` counts claims with a SUPPORTED, CONTRADICTED or NOT_ENOUGH_EVIDENCE verdict;\nERROR results are not checked and are counted separately. ``value`` is null when nothing was\nchecked, never 0% or 100%.",
      "properties": {
        "checked": {
          "minimum": 0,
          "title": "Checked",
          "type": "integer"
        },
        "supported": {
          "minimum": 0,
          "title": "Supported",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "supported",
        "checked"
      ],
      "title": "EvidenceCoverage",
      "type": "object"
    },
    "EvidencePassage": {
      "additionalProperties": false,
      "description": "A verbatim excerpt of one reference document, located by offsets into that document.",
      "properties": {
        "doc_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Doc Id",
          "type": "string"
        },
        "doc_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Doc Text Sha256",
          "type": "string"
        },
        "passage_id": {
          "pattern": "^psg_[A-Za-z0-9_-]{1,64}$",
          "title": "Passage Id",
          "type": "string"
        },
        "reference_set_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Set Id"
        },
        "retrieval": {
          "$ref": "#/$defs/RetrievalProvenance"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "passage_id",
        "doc_id",
        "doc_text_sha256",
        "span",
        "text",
        "retrieval"
      ],
      "title": "EvidencePassage",
      "type": "object"
    },
    "EvidenceStrength": {
      "description": "How strongly the accepted evidence backs a definite verdict. An ordinal label from fixed\nrules (``evidence_strength``), not a probability: it has not been calibrated.",
      "enum": [
        "strong",
        "moderate",
        "weak",
        "none"
      ],
      "title": "EvidenceStrength",
      "type": "string"
    },
    "GuardRejectionReason": {
      "enum": [
        "no_citation",
        "unknown_passage",
        "passage_provenance_invalid",
        "quote_not_found",
        "quote_too_short",
        "partial_quote_drops_negation",
        "instruction_text",
        "unsupported_quantity",
        "unsupported_date",
        "missing_qualifier",
        "unsupported_name",
        "negation_mismatch",
        "conflicting_evidence"
      ],
      "title": "GuardRejectionReason",
      "type": "string"
    },
    "PipelineStage": {
      "enum": [
        "request",
        "extraction",
        "retrieval",
        "verification",
        "citation_validation",
        "correction",
        "scoring"
      ],
      "title": "PipelineStage",
      "type": "string"
    },
    "ProcessingError": {
      "additionalProperties": false,
      "description": "A failure the caller can act on.\n\n``message`` is shown to clients: it must never contain secrets, prompts, raw provider\nresponses or document text.",
      "properties": {
        "claim_id": {
          "anyOf": [
            {
              "pattern": "^clm_[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Id"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retry_after_seconds": {
          "anyOf": [
            {
              "maximum": 3600,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Seconds"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "stage": {
          "$ref": "#/$defs/PipelineStage"
        }
      },
      "required": [
        "code",
        "stage",
        "message",
        "retryable"
      ],
      "title": "ProcessingError",
      "type": "object"
    },
    "ReferenceDescriptor": {
      "additionalProperties": false,
      "description": "Identifies an exact reference text without carrying it. Used for provenance in reports.",
      "properties": {
        "doc_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Doc Id",
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Text Sha256",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "doc_id",
        "text_sha256"
      ],
      "title": "ReferenceDescriptor",
      "type": "object"
    },
    "RejectedCitation": {
      "additionalProperties": false,
      "description": "A citation the model gave that the citation guard did not accept.",
      "properties": {
        "cited_as": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cited As"
        },
        "passage_id": {
          "anyOf": [
            {
              "pattern": "^psg_[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passage Id"
        },
        "reason": {
          "$ref": "#/$defs/GuardRejectionReason"
        }
      },
      "required": [
        "reason"
      ],
      "title": "RejectedCitation",
      "type": "object"
    },
    "ReportScore": {
      "additionalProperties": false,
      "description": "The engine-side score of a report: counts, evidence coverage and review routing.\n\nDeliberately not a confidence or quality score. Each number answers one question about the\nverdicts and nothing else; retrieval scores stay on passages and citation outcomes stay on\neach result's citation_guard. No thresholds are applied: ``requires_human_review`` is true\nwhenever any reason applies.",
      "properties": {
        "citations_rejected": {
          "minimum": 0,
          "title": "Citations Rejected",
          "type": "integer"
        },
        "claims": {
          "minimum": 0,
          "title": "Claims",
          "type": "integer"
        },
        "contradicted": {
          "minimum": 0,
          "title": "Contradicted",
          "type": "integer"
        },
        "corrections_need_review": {
          "minimum": 0,
          "title": "Corrections Need Review",
          "type": "integer"
        },
        "corrections_proposed": {
          "minimum": 0,
          "title": "Corrections Proposed",
          "type": "integer"
        },
        "errors": {
          "minimum": 0,
          "title": "Errors",
          "type": "integer"
        },
        "evidence_coverage": {
          "$ref": "#/$defs/EvidenceCoverage"
        },
        "not_enough_evidence": {
          "minimum": 0,
          "title": "Not Enough Evidence",
          "type": "integer"
        },
        "requires_human_review": {
          "title": "Requires Human Review",
          "type": "boolean"
        },
        "review_reasons": {
          "items": {
            "$ref": "#/$defs/ReviewReason"
          },
          "title": "Review Reasons",
          "type": "array"
        },
        "rule_violations": {
          "default": 0,
          "minimum": 0,
          "title": "Rule Violations",
          "type": "integer"
        },
        "supported": {
          "minimum": 0,
          "title": "Supported",
          "type": "integer"
        }
      },
      "required": [
        "claims",
        "supported",
        "contradicted",
        "not_enough_evidence",
        "errors",
        "evidence_coverage",
        "citations_rejected",
        "corrections_proposed",
        "corrections_need_review",
        "requires_human_review",
        "review_reasons"
      ],
      "title": "ReportScore",
      "type": "object"
    },
    "ReportStatus": {
      "enum": [
        "COMPLETED",
        "PARTIAL",
        "FAILED"
      ],
      "title": "ReportStatus",
      "type": "string"
    },
    "RetrievalMethod": {
      "enum": [
        "bm25"
      ],
      "title": "RetrievalMethod",
      "type": "string"
    },
    "RetrievalProvenance": {
      "additionalProperties": false,
      "description": "How a passage was found. Scores are only comparable within one retrieval call.",
      "properties": {
        "method": {
          "$ref": "#/$defs/RetrievalMethod"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "score": {
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "method",
        "score",
        "rank"
      ],
      "title": "RetrievalProvenance",
      "type": "object"
    },
    "ReviewReason": {
      "enum": [
        "contradicted_claims",
        "unverified_claims",
        "processing_errors",
        "citations_rejected",
        "corrections_need_review",
        "weak_evidence",
        "conflicting_evidence",
        "policy_threshold",
        "rule_violations"
      ],
      "title": "ReviewReason",
      "type": "string"
    },
    "RuleCategory": {
      "enum": [
        "terminology",
        "brand_compliance",
        "accessibility"
      ],
      "title": "RuleCategory",
      "type": "string"
    },
    "RuleEvidence": {
      "additionalProperties": false,
      "description": "The shared contract's evidence item: a source id, the exact quote, and its relation.",
      "properties": {
        "quote": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "relation": {
          "const": "contradicts",
          "default": "contradicts",
          "title": "Relation",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "quote"
      ],
      "title": "RuleEvidence",
      "type": "object"
    },
    "RuleFinding": {
      "additionalProperties": false,
      "description": "One rule violation, in the shared finding contract's shape (check_type \"rule\").\n\n* ``span`` is always a non-empty range into the content (the backend stores span_end >\n  span_start). ``scope`` \"text\": the span is the offending text. ``scope`` \"document\":\n  something is missing (a required term, a disclaimer, an image's alt text known only from\n  metadata), and the span anchors the finding on the content's first line.\n* ``verification_status`` is always ``not_applicable``: a rule check is not a claim checked\n  against evidence. ``requires_human_review`` is always true: a person decides.\n* ``suggested_correction`` replaces ``original_text`` and exists only for terminology rules\n  that name the wording to use. ``suggestion_basis`` says why it may be offered: the rule is\n  quoted from an approved document (\"approved_document\", with evidence) or configured by\n  the brand (\"brand_rule\"). Accessibility and compliance findings never carry one.",
      "properties": {
        "category": {
          "$ref": "#/$defs/RuleCategory"
        },
        "check_type": {
          "const": "rule",
          "default": "rule",
          "title": "Check Type",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RuleEvidence"
          },
          "maxItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "explanation": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "finding_id": {
          "pattern": "^rul_[A-Za-z0-9_.:-]{1,160}$",
          "title": "Finding Id",
          "type": "string"
        },
        "original_text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Original Text",
          "type": "string"
        },
        "requires_human_review": {
          "const": true,
          "default": true,
          "title": "Requires Human Review",
          "type": "boolean"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_type": {
          "$ref": "#/$defs/RuleType"
        },
        "scope": {
          "default": "text",
          "enum": [
            "text",
            "document"
          ],
          "title": "Scope",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/RuleSeverity"
        },
        "source_ids": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 1,
          "title": "Source Ids",
          "type": "array"
        },
        "span": {
          "$ref": "#/$defs/SourceSpan"
        },
        "suggested_correction": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Correction"
        },
        "suggestion_basis": {
          "anyOf": [
            {
              "enum": [
                "approved_document",
                "brand_rule"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion Basis"
        },
        "verification_status": {
          "const": "not_applicable",
          "default": "not_applicable",
          "title": "Verification Status",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "rule_id",
        "rule_type",
        "category",
        "severity",
        "original_text",
        "span",
        "explanation"
      ],
      "title": "RuleFinding",
      "type": "object"
    },
    "RuleSeverity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RuleSeverity",
      "type": "string"
    },
    "RuleType": {
      "enum": [
        "required_term",
        "prohibited_term",
        "product_naming",
        "preferred_term",
        "spelling",
        "terminology_consistency",
        "required_disclaimer",
        "numeric_limit",
        "all_caps_run",
        "emoji_run",
        "vague_link_text",
        "missing_alt_text",
        "heading_structure",
        "missing_captions",
        "low_contrast"
      ],
      "title": "RuleType",
      "type": "string"
    },
    "SaferWording": {
      "additionalProperties": false,
      "description": "A suggested safer wording for part of an UNVERIFIED (NOT_ENOUGH_EVIDENCE) claim\n(softening.py). It only removes or softens words and is **not evidence-backed**: there is no\nevidence for an unverified claim. It is kept apart from ``Correction`` (evidence-backed, only\non CONTRADICTED claims), labelled as such, and never makes the claim supported.",
      "properties": {
        "evidence_backed": {
          "const": false,
          "default": false,
          "title": "Evidence Backed",
          "type": "boolean"
        },
        "label": {
          "const": "safer_wording",
          "default": "safer_wording",
          "title": "Label",
          "type": "string"
        },
        "original_text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Original Text",
          "type": "string"
        },
        "replacement_text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Replacement Text",
          "type": "string"
        },
        "target_span": {
          "$ref": "#/$defs/SourceSpan"
        }
      },
      "required": [
        "target_span",
        "original_text",
        "replacement_text"
      ],
      "title": "SaferWording",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "A half-open ``[start, end)`` range of code points in one specific text.",
      "properties": {
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "SUPPORTED",
        "CONTRADICTED",
        "NOT_ENOUGH_EVIDENCE",
        "ERROR"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "What the engine returns for one VerificationRequest.",
  "properties": {
    "content_length": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Content Length",
      "type": "integer"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "contract_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Contract Version",
      "type": "string"
    },
    "errors": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProcessingError"
      },
      "title": "Errors",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/EngineProvenance"
    },
    "reference_set_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Set Id"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/ReferenceDescriptor"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "References",
      "type": "array"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Request Id",
      "type": "string"
    },
    "results": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ClaimResult"
      },
      "maxItems": 200,
      "title": "Results",
      "type": "array"
    },
    "rule_findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RuleFinding"
      },
      "maxItems": 200,
      "title": "Rule Findings",
      "type": "array"
    },
    "score": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReportScore"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "$ref": "#/$defs/ReportStatus"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "tenant_id",
    "content_sha256",
    "content_length",
    "references",
    "status",
    "provenance"
  ],
  "title": "VerificationReport",
  "type": "object"
}
