# Copy to .env (never commit it) or set these in the environment. Server-side only.

# Required. OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required. Comma-separated OpenRouter model ids, tried in order. Pick ids from
# https://openrouter.ai/models that support structured outputs, e.g. a Gemini Flash model
# first and a Llama model as fallback. Check the exact ids there; they change over time.
INKLOOM_LLM_MODELS=

# Optional (defaults shown).
# INKLOOM_LLM_TIMEOUT_SECONDS=30
# INKLOOM_LLM_MAX_RETRIES=2
# INKLOOM_LLM_SEED=0                      # "none" to send no seed
# INKLOOM_LLM_STRUCTURED_OUTPUT=json_schema   # or json_object for models without schema support
# INKLOOM_LLM_DATA_COLLECTION=deny        # deny = only providers that do not collect prompt data
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
