# The engine and eval/run_eval.py read ONLY the process environment; they never load a .env file.
# Set these in the shell that runs the command (never commit real values). Server-side only.
#   PowerShell:  $env:INKLOOM_LLM_MODELS = "nvidia/nemotron-3.5-super-vl:free"
#   cmd.exe:     set INKLOOM_LLM_MODELS=nvidia/nemotron-3.5-super-vl:free     (no quotes: cmd keeps them)
#   bash:        export INKLOOM_LLM_MODELS=nvidia/nemotron-3.5-super-vl:free
# A tool that loads .env files for you (e.g. services/api, which uses python-dotenv) can read the
# same names; services/api/.env is that backend's own file.

# Required. OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required. Comma-separated list of 1 to 5 OpenRouter model ids, tried in order. Each id is
# provider/model with an optional :variant (e.g. :free). No quotes, no JSON, no brackets, no
# name=model mappings. Spaces after commas are fine. Pick ids from https://openrouter.ai/models
# that support structured outputs; check the exact ids there, they change over time.
# Example: INKLOOM_LLM_MODELS=nvidia/nemotron-3.5-super-vl:free,meta-llama/llama-3.3-70b-instruct:free
INKLOOM_LLM_MODELS=

# Optional (defaults shown).
# INKLOOM_LLM_TIMEOUT_SECONDS=30
# INKLOOM_LLM_MAX_RETRIES=2
# INKLOOM_LLM_SEED=0                      # "none" to send no seed
# INKLOOM_LLM_STRUCTURED_OUTPUT=json_schema   # or json_object for models without schema support
# INKLOOM_LLM_DATA_COLLECTION=deny        # deny = only providers that do not collect prompt data
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
