{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inkloom.ai/contract/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "severity",
    "original_text",
    "span",
    "check_type",
    "verification_status",
    "requires_human_review",
    "evidence"
  ],
  "properties": {
    "finding_id": { "type": "string", "format": "uuid" },
    "category": { "type": ["string", "null"] },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "original_text": { "type": "string" },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      },
      "description": "Half-open [start, end) Unicode code point offsets into the content version's text."
    },
    "check_type": { "enum": ["rule", "retrieval", "semantic"] },
    "explanation": { "type": ["string", "null"] },
    "verification_status": {
      "enum": ["supported", "contradicted", "unverified", "conflicting_sources", "not_applicable"]
    },
    "suggested_correction": { "type": ["string", "null"] },
    "requires_human_review": { "type": "boolean" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/definitions/EvidenceLink" }
    }
  },
  "definitions": {
    "EvidenceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "quote", "relation"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "source_id": { "type": ["string", "null"], "format": "uuid" },
        "source_version_id": { "type": ["string", "null"], "format": "uuid" },
        "quote": { "type": "string" },
        "relation": { "enum": ["supports", "contradicts", "context"] }
      }
    }
  }
}
